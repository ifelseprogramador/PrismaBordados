# Copie este arquivo para .env.local e preencha com os valores do seu
# próprio projeto Supabase (https://supabase.com/dashboard -> Project
# Settings). Este é um projeto-TEMPLATE — não há projeto Supabase
# vinculado a ele; quem criar um vertical a partir deste template cria o
# seu próprio projeto Supabase do zero.
#
# Atenção com senhas/segredos que contêm "#": em arquivo .env, "#" inicia
# um comentário e trunca o resto da linha. Coloque o valor entre aspas
# duplas quando ele tiver "#" (ex.: SEED_ADMIN_PASSWORD="Minha#Senha123").

# Project Settings -> API. NOTA: aqui usamos o prefixo NEXT_PUBLIC_ (em
# vez de só SUPABASE_URL/SUPABASE_ANON_KEY) porque o Next.js só consegue
# embutir uma env var no bundle do navegador quando ela tem esse prefixo
# E é acessada como propriedade literal (`process.env.NEXT_PUBLIC_X`) —
# ver core/env.ts e core/supabase/client.ts. Sem o prefixo, o login (que
# roda no navegador) quebraria silenciosamente em produção.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> service_role (secreta! nunca expor ao
# cliente, nunca prefixar com NEXT_PUBLIC_). Usada pelo script de seed
# (src/db/seed.ts) e pela área /admin (core/supabase/admin.ts) para criar
# usuários via Admin API contornando confirmação de e-mail.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> URI. Conexão de
# RUNTIME da aplicação — em produção DEVE conectar como o papel
# `base_erp_app` (sem bypassrls, ver src/db/migrations-custom/0000_app_role.sql
# e docs/decisoes.md, "RLS ativa desde o início"), não como `postgres`.
# Use o pooler em modo "Transaction" (porta 6543).
#
# ATENÇÃO — validado contra um projeto Supabase real em 2026-09-24 (ver
# docs/decisoes.md): o pooler (Supavisor) do Supabase EXIGE o project ref
# como sufixo do username (`base_erp_app.<project-ref>`, não só
# `base_erp_app`) — sem o sufixo a conexão falha com
# `FATAL: no tenant identifier provided`. O project ref é o mesmo texto
# que aparece em NEXT_PUBLIC_SUPABASE_URL (https://<project-ref>.supabase.co).
# A senha do papel não existe até você definí-la (ver README "Configurando
# o banco", passo a passo depois de rodar `db:migrate`).
DATABASE_URL=postgresql://base_erp_app.xxxxxxxxxxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Opcional: conexão PRIVILEGIADA usada só por `npm run db:migrate` e
# `npm run db:generate`/`db:studio` (drizzle-kit) — precisa ser o papel
# dono do projeto (`postgres`) para poder criar o papel `base_erp_app`,
# as funções SECURITY DEFINER e as policies de RLS. Se não definida, os
# scripts de migração caem para DATABASE_URL (conveniente só em ambiente
# de teste local onde você é o único papel disponível — nesse caso a RLS
# não fica de fato isolada do dono da conexão, ver docs/decisoes.md).
#
# Use a DIRECT CONNECTION (não o pooler) — host `db.<project-ref>.supabase.co`,
# porta 5432, username `postgres` sem sufixo nenhum.
DATABASE_MIGRATION_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Seed (src/db/seed.ts): dados da primeira organização/usuário de teste.
SEED_ORG_NAME="Organização Exemplo"
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=troque-esta-senha

# Seed: seu login como dono da plataforma (área /admin). Se deixar em
# branco, usa SEED_OWNER_EMAIL/PASSWORD (só prático para teste local; em
# produção, defina o SEU e-mail de verdade aqui).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Protege GET /api/cron/backup (backup automático diário) — o Vercel Cron
# manda automaticamente "Authorization: Bearer <valor>" quando esta
# variável existe no projeto (Project Settings -> Environment Variables).
# Gere um valor aleatório qualquer (ex.: openssl rand -hex 32).
CRON_SECRET=
